<?php

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\commerce_order\Entity\OrderInterface;

function commerce_email_order_hidden_entity_base_field_info_alter(array &$fields, EntityTypeInterface $entity_type): void {
  if ($entity_type->id() === 'commerce_order' && isset($fields['mail'])) {
    $fields['mail']->setRequired(FALSE);
    $fields['mail']->setConstraints([]);
  }
}

function commerce_email_order_hidden_page_attachments(array &$attachments): void {
  if (\Drupal::currentUser()->isAnonymous()) {
    $attachments['#attached']['library'][] = 'commerce_email_order_hidden/hide_email';
  }
}

function commerce_email_order_hidden_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (\Drupal::currentUser()->isAnonymous()) {
    $form['#attached']['library'][] = 'commerce_email_order_hidden/hide_email';
  }
  _commerce_email_order_hidden_hide_recursive($form);
  if (!isset($form['contact_information']) && !isset($form['email']) && !str_contains($form_id, 'commerce_checkout')) {
    return;
  }
  if (isset($form['contact_information']) && \Drupal::currentUser()->isAnonymous() === FALSE) {
    return;
  }
  $hiddenValue = _commerce_email_order_hidden_generate_dummy_email($form_state);
  $candidates = [
    ['contact_information', 'email'],
    ['contact_information', 'mail'],
    ['contact_information', 'contact_information', 'email'],
    ['contact_information', 'contact_information', 'mail'],
    ['email'],
    ['mail'],
  ];
  foreach ($candidates as $path) {
    $ref = &$form;
    $found = TRUE;
    foreach ($path as $key) {
      if (!isset($ref[$key])) {
        $found = FALSE;
        break;
      }
      $ref = &$ref[$key];
    }
    if ($found && is_array($ref)) {
      $ref['#access'] = FALSE;
      $ref['#required'] = FALSE;
      $ref['#element_validate'] = [];
      $ref['#validated'] = TRUE;
      $ref['#value'] = $hiddenValue;
      $ref['#default_value'] = $hiddenValue;
      $ref['#attributes']['style'] = 'display:none!important';
      $ref['#type'] = 'hidden';
    }
    unset($ref);
  }
  if (isset($form['contact_information']) && is_array($form['contact_information'])) {
    if (isset($form['contact_information']['email'])) {
      $form['contact_information']['email']['#access'] = FALSE;
    }
    if (isset($form['contact_information']['mail'])) {
      $form['contact_information']['mail']['#access'] = FALSE;
    }
    if (isset($form['contact_information']['#title'])) {
      $form['contact_information']['#title'] = '';
    }
    if (\Drupal::currentUser()->isAnonymous()) {
      $keys = array_filter(array_keys($form['contact_information']), fn($k) => !str_starts_with($k, '#'));
      $onlyEmail = empty($keys) || (count($keys) === 1 && in_array($keys[0], ['email', 'mail'])) || (count($keys) === 2 && in_array('email', $keys) && in_array('mail', $keys));
      if ($onlyEmail || !str_contains($form_id, 'commerce_checkout') === FALSE) {
        $form['contact_information']['#access'] = FALSE;
      }
    }
  }
  if (\Drupal::currentUser()->isAnonymous() && isset($form['contact_information'])) {
    $form['contact_information']['#access'] = FALSE;
  }
  $form['#validate'][] = '_commerce_email_order_hidden_checkout_validate';
  $form['#after_build'][] = '_commerce_email_order_hidden_after_build';
  $form['#attached']['library'][] = 'commerce_email_order_hidden/hide_email';
}

function _commerce_email_order_hidden_hide_recursive(array &$element): void {
  foreach ($element as $key => &$value) {
    if (!is_array($value) || str_starts_with((string) $key, '#')) {
      continue;
    }
    if (isset($value['#type']) && $value['#type'] === 'email') {
      $title = (string) ($value['#title'] ?? '');
      if ($title === 'Email' || $title === 'E-mail' || $key === 'email' || $key === 'mail') {
        if (\Drupal::currentUser()->isAnonymous()) {
          $value['#access'] = FALSE;
          $value['#required'] = FALSE;
          $value['#type'] = 'hidden';
          $value['#value'] = _commerce_email_order_hidden_generate_dummy_email();
          $value['#default_value'] = $value['#value'];
        }
      }
    }
    foreach (['#plain_text', '#markup', '#text'] as $tk) {
      if (isset($value[$tk]) && is_string($value[$tk]) && str_contains($value[$tk], '@example.invalid')) {
        if (\Drupal::currentUser()->isAnonymous()) {
          $value['#access'] = FALSE;
          $value[$tk] = '';
        }
      }
    }
    if (is_array($value)) {
      _commerce_email_order_hidden_hide_recursive($value);
    }
  }
}

function _commerce_email_order_hidden_after_build(array $form, FormStateInterface $form_state): array {
  $hiddenValue = _commerce_email_order_hidden_generate_dummy_email($form_state);
  foreach (['email', 'mail'] as $key) {
    if (isset($form['contact_information'][$key])) {
      $form['contact_information'][$key]['#access'] = FALSE;
      $form['contact_information'][$key]['#value'] = $hiddenValue;
    }
    if (isset($form[$key])) {
      $form[$key]['#access'] = FALSE;
      $form[$key]['#value'] = $hiddenValue;
    }
  }
  _commerce_email_order_hidden_hide_recursive($form);
  return $form;
}

function _commerce_email_order_hidden_checkout_validate(array $form, FormStateInterface $form_state): void {
  $hiddenValue = _commerce_email_order_hidden_generate_dummy_email($form_state);
  $emailPaths = [
    ['contact_information', 'mail'],
    ['contact_information', 'email'],
    ['mail'],
    ['email'],
  ];
  foreach ($emailPaths as $path) {
    $value = $form_state->getValue($path);
    if (empty($value) || str_contains((string) $value, 'example.invalid')) {
      $form_state->setValue($path, $hiddenValue);
    }
  }
  $mail = $form_state->getValue(['contact_information', 'mail']) ?: $form_state->getValue(['contact_information', 'email']) ?: $form_state->getValue('mail') ?: $form_state->getValue('email');
  $email = $form_state->getValue(['contact_information', 'email']) ?: $mail;
  $final = !empty($mail) ? $mail : (!empty($email) ? $email : $hiddenValue);
  $final = trim((string) $final);
  if (empty($final) || !str_contains($final, '@')) {
    $final = $hiddenValue;
  }
  foreach ($emailPaths as $path) {
    $form_state->setValue($path, $final);
  }
  $form_state->setValue('mail', $final);
  $form_state->setValue('email', $final);
}

function _commerce_email_order_hidden_generate_dummy_email(?FormStateInterface $form_state = NULL): string {
  $config = \Drupal::config('commerce_email_order_hidden.settings');
  $domain = $config->get('dummy_domain') ?: 'example.invalid';
  $prefix = $config->get('dummy_prefix') ?: 'guest';
  $phone = NULL;
  if ($form_state) {
    $candidates = [
      ['contact_information', 'phone'],
      ['billing_information', 'phone'],
      ['shipping_information', 'phone'],
      ['contact_information', 'telephone'],
      ['billing_information', 'telephone'],
      ['phone'],
      ['telephone'],
    ];
    foreach ($candidates as $path) {
      $v = $form_state->getValue($path);
      if (!empty($v) && is_string($v)) {
        $phone = $v;
        break;
      }
      if (is_array($v) && !empty($v['value'])) {
        $phone = $v['value'];
        break;
      }
    }
  }
  if (!empty($phone)) {
    $phone = preg_replace('/\D+/', '', $phone);
    if (strlen($phone) >= 7) {
      return $prefix . '+' . $phone . '@' . $domain;
    }
  }
  return $prefix . '+' . time() . bin2hex(random_bytes(3)) . '@' . $domain;
}

function commerce_email_order_hidden_entity_presave(EntityInterface $entity): void {
  if (!$entity instanceof OrderInterface) {
    return;
  }
  $email = (string) $entity->getEmail();
  if (!empty($email) && filter_var($email, FILTER_VALIDATE_EMAIL) && !str_contains($email, 'example.invalid')) {
    return;
  }
  $dummy = _commerce_email_order_hidden_generate_dummy_email();
  $profile = $entity->getBillingProfile();
  if ($profile && $profile->hasField('field_phone') && !$profile->get('field_phone')->isEmpty()) {
    $phone = preg_replace('/\D+/', '', (string) $profile->get('field_phone')->value);
    if (strlen($phone) >= 7) {
      $config = \Drupal::config('commerce_email_order_hidden.settings');
      $domain = $config->get('dummy_domain') ?: 'example.invalid';
      $prefix = $config->get('dummy_prefix') ?: 'guest';
      $dummy = $prefix . '+' . $phone . '@' . $domain;
    }
  }
  $entity->setEmail($dummy);
}
